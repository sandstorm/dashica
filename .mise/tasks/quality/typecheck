#!/bin/bash
#MISE description="Type-check the frontend's TypeScript and the generated contract (strict tsc, no output)"
# All of frontend/, including frontend/generated: the types dashica-gen writes and the golden contract checked against
# them (see TestContract_Golden in contract_test.go), generated first, so tsc never checks stale types.
set -e
(cd lib && go generate ./...)
npx -y -p typescript@5.9.3 tsc --noEmit --strict --target ESNext --module ESNext --moduleResolution bundler \
  --lib ESNext,DOM,DOM.Iterable --skipLibCheck --types vite/client,node \
  $(find frontend -name '*.ts')
