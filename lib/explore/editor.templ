package explore

// DEPRECATED (workbench): Explore's Go API, kept for its rebuild on the workbench; its UI is gone. Port into the rebuild or delete, then remove this line. See docs/2026-10-28-workbench.md §5.

// RebuildNotice is what /explore shows until Explore is rebuilt on the workbench.
templ RebuildNotice() {
	<div class="p-8">
		<h1>Explore is being rebuilt</h1>
		<p>Explore moves onto the new workbench. Until it is back, use the dashboards.</p>
	</div>
}
