package layout

import (
	"github.com/sandstorm/dashica/lib/dashboard/rendering"
)

// MainApplication is the server-rendered page inside the workbench (docs/2026-10-28-workbench.md, step 3b): the
// parts are staged hidden as [data-workbench-part] elements, and the workbench (frontend/workbench, assembled by
// window.Dashica.initWorkbench before Alpine.start()) moves them into its regions: menu → left panel, search bar →
// filter bar, content → content, debug → bottom panel. The page-level filter scope sits on the wrapper, so the search
// bar's SQL filter and the charts still resolve the same scope by containment.
templ MainApplication(renderingContext rendering.DashboardContext, searchBar rendering.SearchBarOption, content templ.Component) {
	<div x-data="filterScope" data-filter-scope>
		<div id="workbench"></div>
		<div data-workbench-staging hidden>
			<aside data-workbench-part="menu" class="application__sidebar">
				@PageMenu(renderingContext)
			</aside>
			<div data-workbench-part="searchbar" class="dashboard-searchbar">
				if searchBar.IsVisible {
					@SearchBar(renderingContext, searchBar)
				}
			</div>
			<main data-workbench-part="content" class="dashboard-content prose max-w-none">
				@content
			</main>
			<div data-workbench-part="debug">
				@DebugDrawerPanel()
			</div>
		</div>
	</div>
}

templ defaultPageFn(renderingContext rendering.DashboardContext, searchBar rendering.SearchBarOption, content templ.Component) {
	<html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Dashica</title>
			<link rel="stylesheet" href="/public/dist/index.css"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png"/>
			<script src="/public/dist/index.js"></script>
		</head>
		<body class="bg-base-200">
			@MainApplication(renderingContext, searchBar, content)
			<script>window.Dashica.initWorkbench(); window.Alpine.start();</script>
		</body>
	</html>
}
